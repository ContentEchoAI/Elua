{
  "name": "hummingbird-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "qa:hummingbird": "node scripts/hummingbird-qa-bot.mjs",
    "qa:hummingbird:checks": "node scripts/hummingbird-qa-bot.mjs --checks",
    "lead:finder": "node scripts/hummingbird-lead-finder.mjs",
    "builder:bot": "node scripts/hummingbird-builder-bot.mjs",
    "builder:bot:test": "node --test scripts/hummingbird-builder-bot.test.mjs",
    "meta:publishing:status": "node --env-file=.env.local scripts/meta-publishing-gate.mjs status",
    "meta:publishing:enable": "node --env-file=.env.local scripts/meta-publishing-gate.mjs enable",
    "meta:publishing:disable": "node --env-file=.env.local scripts/meta-publishing-gate.mjs disable",
    "outreach:status": "node scripts/hummingbird-outreach-queue.mjs status",
    "outreach:approve": "node scripts/hummingbird-outreach-queue.mjs approve",
    "outreach:sent": "node scripts/hummingbird-outreach-queue.mjs sent",
    "outreach:followed-up": "node scripts/hummingbird-outreach-queue.mjs followed-up",
    "outreach:replied": "node scripts/hummingbird-outreach-queue.mjs replied",
    "outreach:close": "node scripts/hummingbird-outreach-queue.mjs close",
    "outreach:test": "node --test scripts/hummingbird-outreach-core.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.0",
    "@supabase/supabase-js": "^2.105.3",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
